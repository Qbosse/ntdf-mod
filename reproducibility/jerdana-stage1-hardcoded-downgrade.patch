+void stage1_apply() {
+	if(test_complete || apply_active || saved_slot || original_config || target_config) {
+		outfit_test_status = 3;
+		return;
+	}
+	int slot, config, id;
+	get_outfit_state(slot, config, id);
+	int manager = GetItemManager();
+	int candidate = manager ? GetItemConfig(manager, 130) : 0;
+	int target_id = outfit_item_id(candidate);
+	if(!slot || !config || id != 133 || !candidate || target_id != 130) {
+		outfit_test_status = 3;
+		return;
+	}
+	saved_slot = slot;
+	original_config = config;
+	target_config = candidate;
+	apply_active = true;
+	*((int*)saved_slot) = target_config;
+	int active_config = *((int*)saved_slot);
+	int active_id = outfit_item_id(active_config);
+	if(active_config == target_config) {
+		outfit_test_status = active_id == 130 ? 1 : 5;
+	} else if(active_config == original_config) {
+		saved_slot = 0;
+		original_config = 0;
+		target_config = 0;
+		apply_active = false;
+		test_complete = true;
+		outfit_test_status = 4;
+	} else {
+		outfit_test_status = 6;
+	}
+}
+
+void stage1_restore() {
