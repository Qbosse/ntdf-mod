+void get_outfit_state(int &slot, int &config, int &id) {
+	slot = 0;
+	config = 0;
+	id = -1;
+	int items = *((int*)0x35c7ec);
+	if(items) slot = GetCurrentEquipmentSlot(items, 1);
+	if(slot) {
+		config = *((int*)slot);
+		id = outfit_item_id(config);
+	}
+}
